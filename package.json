{
  "name": "itty-web",
  "private": true,
  "description": "Build tooling for the itty browser client",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint web/src",
    "test": "tsc -p tsconfig.json && node --require ./web/test-setup.js --test web/*.test.js",
    "check:build": "scripts/check-web-build.sh",
    "postinstall": "node scripts/exclude-node-modules-from-go.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:build && pnpm test"
  },
  "packageManager": "pnpm@9.15.9"
}
