[Unit]
Description=itty web terminal
After=network-online.target
Wants=network-online.target

[Service]
User={{.User}}
WorkingDirectory={{.WorkingDir}}
ExecStart="{{.Executable}}" serve --config "{{.ConfigPath}}"
Restart=on-failure
RestartSec=5
KillMode=process

[Install]
WantedBy=multi-user.target
